{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "3.0.0",
  "description": "Lets a local MCP client drive this browser over a mutually authenticated localhost connection, with pause, stop, permissions and an audit log.",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "storage", "alarms", "notifications", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Browser Bridge", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-pause": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Pause or resume automation" },
    "emergency-stop": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Emergency stop: halt automation and revoke approvals" }
  }
}
